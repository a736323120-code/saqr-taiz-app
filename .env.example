const SUPABASE_URL = "{{https://dgxrjgyttdtsfdheygvu.supabase.co/rest/v1/}}";
const SUPABASE_PUBLIC_KEY = "{{sb_publishable_BXs--kTITpEX6VfI9kjtNQ_hGd7oRsd}}";

